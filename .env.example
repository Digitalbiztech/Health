# ─── API Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medical_saas
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medical_saas

# ─── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Frontend (Vite — prefix with VITE_) ─────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=http://localhost:4000

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Extraction service (apps/extraction) ────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
MISTRAL_API_KEY=...
MISTRAL_MODEL=mistral-small-latest

# Text normalization (OpenAI primary → Mistral fallback).
# Falls back to OPENAI_MODEL / MISTRAL_MODEL when unset.
OPENAI_NORMALIZATION_MODEL=gpt-4o-mini
MISTRAL_NORMALIZATION_MODEL=mistral-small-latest
NORMALIZATION_MAX_RETRIES=1
NORMALIZATION_TIMEOUT=30.0
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN_SECONDS=60.0