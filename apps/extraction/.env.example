# ─── AI providers ────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# ─── OCR Text Normalization (OpenAI primary → Mistral fallback) ─
OPENAI_NORMALIZATION_MODEL=gpt-4o-mini
MISTRAL_NORMALIZATION_MODEL=mistral-large-latest
NORMALIZATION_MAX_RETRIES=1
NORMALIZATION_TIMEOUT=30.0
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN_SECONDS=60.0

# ─── Database ────────────────────────────────────────────────────
SUPABASE_DB_URL=postgresql://user:password@db.supabase.co:5432/postgres

# ─── LLM ─────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# ─── Embeddings ──────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ─── Service auth ────────────────────────────────────────────────
EXTRACTION_SERVICE_SECRET=

# ─── RAG tunables ────────────────────────────────────────────────
RAG_MAX_DISTANCE=0.6
ENABLE_QUERY_REWRITE=true
ENABLE_PUBMED=true
NCBI_API_KEY=
RAG_DEBUG=false
